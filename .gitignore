# Ignore dependencies and build files
**/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor

# Laravel-specific caches and logs
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/logs/*.log

# Scribe generated output
/src/.scribe/
/src/public/docs/
/src/resources/views/scribe/

# Built assets published via vendor:publish
/src/public/vendor/
/src/resources/views/vendor
dist
tsconfig.tsbuildinfo

# Ignore environment and configuration files
.env
.env.backup
.env.local
.env.production
.phpunit.result.cache

# Ignore IDE and system files
auth.json
docker-compose.override.yml

# Ignore log files
*.log
yarn-error.log

# Ignore IDE directories
/.fleet
/.history
/.idea
