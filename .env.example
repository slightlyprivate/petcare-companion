APP_NAME="PetCare Companion (Local)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Frontend URL for caregiver invitation emails and CORS
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_local
DB_PORT=3306
DB_DATABASE=petcare_local
DB_USERNAME=petcare
DB_PASSWORD=petcare
DB_ROOT_PASSWORD=rootpass

# === REDIS ===
REDIS_HOST=petcare_redis_local
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@petcare.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (optional for credit purchases & webhooks)
STRIPE_KEY=pk_test_your_key_here
STRIPE_SECRET=sk_test_your_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === INFRASTRUCTURE CONFIG ===
ENV=local

# Container Names
APP_CONTAINER_NAME=petcare_app_local
WEB_CONTAINER_NAME=petcare_web_local
UI_CONTAINER_NAME=petcare_ui_local
PWA_CONTAINER_NAME=petcare_pwa_local
WORKER_CONTAINER_NAME=petcare_worker_local
SCHEDULER_CONTAINER_NAME=petcare_scheduler_local
