# === APP CONFIG ===
APP_NAME="PetCare Companion (Prod Green)"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://web

# === APP KEY ===
APP_KEY=

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_prod
DB_PORT=3306
DB_DATABASE=petcare_prod
DB_USERNAME=petcare
DB_PASSWORD=petcare

# === REDIS ===
REDIS_HOST=petcare_redis_prod
REDIS_PORT=6379
REDIS_PASSWORD=null

# === QUEUE / CACHE ===
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# === FRONTEND API URLS ===
API_BASE_URL=https://web

# === INFRASTRUCTURE CONFIG ===
ENV=prod

# Docker Registry
DOCKER_REGISTRY=

# Blue/Green Deployment Slot
SLOT=green

# Base Domain Configuration
BASE_DOMAIN=prod.lan.slightlyprivate.com

# Service Domains
WEB_DOMAIN=petcare.web.${BASE_DOMAIN}
UI_DOMAIN=petcare.ui.${BASE_DOMAIN}
PWA_DOMAIN=petcare.pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app_green
WEB_CONTAINER_NAME=petcare_web_green
UI_CONTAINER_NAME=petcare_ui_green
PWA_CONTAINER_NAME=petcare_pwa_green
WORKER_CONTAINER_NAME=petcare_worker_green
SCHEDULER_CONTAINER_NAME=petcare_scheduler_green

# Image Tags
IMAGE_TAG=release-1.2.3

# Traefik Configuration
TRAEFIK_ENABLE=false
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver

# Storage Path
STORAGE_PATH=/mnt/data/appdata/petcare-storage-production
