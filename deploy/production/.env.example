# ⚠️  DEPRECATED - Use production-blue/ or production-green/ instead
#
# This single-slot production configuration is deprecated in favor of
# blue/green deployments for zero-downtime updates.
#
# See:
#   - deploy/production-blue/
#   - deploy/production-green/
#   - deploy/DEPLOYMENT.md

APP_NAME=PetCare Companion
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:9080

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=petcare
DB_USERNAME=petcare
DB_PASSWORD=petcare
DB_ROOT_PASSWORD=rootpass

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=production@example.com
MAIL_FROM_NAME="${APP_NAME} Production"

# === INFRASTRUCTURE CONFIG ===
ENV=prod

# Docker Registry - Must be explicitly set (no default)
# Example: ghcr.io/slightlyprivate
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=petcare.ubuntu.slightlyprivate.com

# Service Domains (for Traefik)
WEB_DOMAIN=web.${BASE_DOMAIN}
UI_DOMAIN=ui.${BASE_DOMAIN}
PWA_DOMAIN=pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app
WEB_CONTAINER_NAME=petcare_web
UI_CONTAINER_NAME=petcare_ui
PWA_CONTAINER_NAME=petcare_pwa
WORKER_CONTAINER_NAME=petcare_worker

# Image Tags
IMAGE_TAG=release-latest  # Updated for consistency with new deployment patterns

# Traefik Configuration
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver
