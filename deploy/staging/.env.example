# === APP CONFIG ===
APP_NAME="PetCare Companion (Staging)"
APP_ENV=staging
APP_DEBUG=true
APP_URL=http://web

# === APP KEY ===
APP_KEY=

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_staging
DB_PORT=3306
DB_DATABASE=petcare_staging
DB_USERNAME=petcare
DB_PASSWORD=petcare

# === REDIS ===
REDIS_HOST=petcare_redis_staging
REDIS_PORT=6379
REDIS_PASSWORD=null

# === QUEUE / CACHE ===
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# === FRONTEND API URLS ===
API_BASE_URL=http://web

# === INFRASTRUCTURE CONFIG ===
ENV=staging

# Docker Registry
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=staging.ubuntu.slightlyprivate.com

# Service Domains
WEB_DOMAIN=petcare.web.${BASE_DOMAIN}
UI_DOMAIN=petcare.ui.${BASE_DOMAIN}
PWA_DOMAIN=petcare.pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app_staging
WEB_CONTAINER_NAME=petcare_web_staging
UI_CONTAINER_NAME=petcare_ui_staging
PWA_CONTAINER_NAME=petcare_pwa_staging
WORKER_CONTAINER_NAME=petcare_worker_staging
SCHEDULER_CONTAINER_NAME=petcare_scheduler_staging

# Image Tags
IMAGE_TAG=staging-latest

# Traefik Configuration
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver

# Storage Path
STORAGE_PATH=/mnt/data/appdata/petcare-storage-staging
