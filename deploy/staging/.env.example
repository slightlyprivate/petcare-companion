APP_NAME=PetCare Companion
APP_ENV=staging
APP_KEY=

APP_URL=http://petcare_web_staging

DB_CONNECTION=mysql
DB_HOST=petcare_develop_mysql   # reachable via shared-db network
DB_PORT=3306
DB_DATABASE=petcare
DB_USERNAME=petuser
DB_PASSWORD=petpass

REDIS_HOST=petcare_develop_redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=petcare_mailhog_staging
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=staging@example.com
MAIL_FROM_NAME="PetCare Staging"

# === INFRASTRUCTURE CONFIG ===
ENV=staging

# Docker Registry - Must be explicitly set (no default)
# Example: ghcr.io/slightlyprivate
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=staging.petcare.ubuntu.slightlyprivate.com

# Service Domains (for Traefik)
WEB_DOMAIN=web.staging.petcare.ubuntu.slightlyprivate.com
UI_DOMAIN=ui.staging.petcare.ubuntu.slightlyprivate.com
PWA_DOMAIN=pwa.staging.petcare.ubuntu.slightlyprivate.com

# Container Names
APP_CONTAINER_NAME=petcare_app_staging
WEB_CONTAINER_NAME=petcare_web_staging
UI_CONTAINER_NAME=petcare_ui_staging
PWA_CONTAINER_NAME=petcare_pwa_staging
WORKER_CONTAINER_NAME=petcare_worker_staging

# Image Tags
# Pattern: latest (latest main build) or specific version (e.g., 1.2.3)
# Set by CI/CD pipeline on push to main branch
IMAGE_TAG=latest

# Traefik Configuration
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver
