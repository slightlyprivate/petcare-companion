# === APP CONFIG ===
APP_NAME="PetCare Companion (Dev)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://web

# === APP KEY ===
# Run inside app container:
# docker exec -it petcare_app_develop php artisan key:generate --show
# Or:
# docker compose run --rm app php artisan key:generate --show
APP_KEY=

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_develop
DB_PORT=3306
DB_DATABASE=petcare_dev
DB_USERNAME=petcare
DB_PASSWORD=petcare

# === REDIS ===
REDIS_HOST=petcare_redis_develop
REDIS_PORT=6379
REDIS_PASSWORD=null

# === QUEUE / CACHE ===
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# === FRONTEND API URLS ===
API_BASE_URL=http://web

# === INFRASTRUCTURE CONFIG ===
ENV=develop

# Docker Registry - Must be explicitly set (no default)
# Example: ghcr.io/slightlyprivate
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=develop.ubuntu.slightlyprivate.com

# Service Domains
WEB_DOMAIN=petcare.web.${BASE_DOMAIN}
UI_DOMAIN=petcare.ui.${BASE_DOMAIN}
PWA_DOMAIN=petcare.pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app_develop
WEB_CONTAINER_NAME=petcare_web_develop
UI_CONTAINER_NAME=petcare_ui_develop
PWA_CONTAINER_NAME=petcare_pwa_develop
WORKER_CONTAINER_NAME=petcare_worker_develop
SCHEDULER_CONTAINER_NAME=petcare_scheduler_develop

# Image Tags
# Pattern: dev-{shortsha} (e.g., dev-4f31a8c)
# Set by CI/CD pipeline on push to develop branch
IMAGE_TAG=dev-latest

# Traefik Configuration
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver

# Storage Path
STORAGE_PATH=/mnt/data/appdata/petcare-storage-develop
