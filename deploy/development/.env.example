# === APP CONFIG ===
APP_NAME=petcare_companion_dev
APP_ENV=local
APP_DEBUG=true
APP_URL=http://web

# === APP KEY ===
# Run inside app container:
# docker exec -it petcare_app_develop php artisan key:generate --show
# Or:
# docker compose run --rm app php artisan key:generate --show
APP_KEY=

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_develop_mysql
DB_PORT=3306
DB_DATABASE=petcare_dev
DB_USERNAME=petcare
DB_PASSWORD=petcare

# === REDIS ===
REDIS_HOST=petcare_develop_redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# === QUEUE / CACHE ===
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# === FRONTEND API URLS ===
API_BASE_URL=http://web

# === INFRASTRUCTURE CONFIG ===
ENV=develop

# Docker Registry - Must be explicitly set (no default)
# Example: ghcr.io/slightlyprivate
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=develop.petcare.ubuntu.slightlyprivate.com

# Service Domains
WEB_DOMAIN=web.${BASE_DOMAIN}
UI_DOMAIN=ui.${BASE_DOMAIN}
PWA_DOMAIN=pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app_${ENV}
WEB_CONTAINER_NAME=petcare_web_${ENV}
UI_CONTAINER_NAME=petcare_ui_${ENV}
PWA_CONTAINER_NAME=petcare_pwa_${ENV}
WORKER_CONTAINER_NAME=petcare_worker_${ENV}
SCHEDULER_CONTAINER_NAME=petcare_scheduler_${ENV}

# Image Tags
# Pattern: dev-{shortsha} (e.g., dev-4f31a8c)
# Set by CI/CD pipeline on push to develop branch
IMAGE_TAG=dev-latest

# Traefik Configuration
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver

# Storage Path
STORAGE_PATH=/mnt/data/appdata/petcare-storage
