# Ignore dependencies and build files
**/node_modules
src/public/hot
src/public/storage
src/storage/*.key
src/vendor

# Laravel-specific caches and logs
src/bootstrap/cache/*.php
src/storage/framework/cache/data/*
src/storage/logs/*.log

# Scribe generated output
/src/.scribe/
/src/public/docs/
/src/resources/views/scribe/

# Built assets published via vendor:publish
/src/public/vendor/
/src/resources/views/vendor
dist
tsconfig.tsbuildinfo

# Ignore environment and configuration files
.env
.env.backup
.env.local
.env.production
.phpunit.result.cache

# Ignore IDE and system files
auth.json
docker-compose.override.yml

# Ignore log files
*.log
yarn-error.log

# Ignore IDE directories
/.fleet
/.history
/.idea
