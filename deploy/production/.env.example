# ⚠️  DEPRECATED - Use production-blue/ or production-green/ instead
#
# This single-slot production configuration is deprecated in favor of
# blue/green deployments for zero-downtime updates.
#
# See:
#   - deploy/production-blue/
#   - deploy/production-green/
#   - deploy/DEPLOYMENT.md

# === APP CONFIG ===
APP_NAME="PetCare Companion (Prod)"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://web

# === APP KEY ===
APP_KEY=

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_prod
DB_PORT=3306
DB_DATABASE=petcare_prod
DB_USERNAME=petcare
DB_PASSWORD=petcare

# === REDIS ===
REDIS_HOST=petcare_redis_prod
REDIS_PORT=6379
REDIS_PASSWORD=null

# === QUEUE / CACHE ===
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# === FRONTEND API URLS ===
API_BASE_URL=https://web

# === INFRASTRUCTURE CONFIG ===
ENV=prod

# Docker Registry
DOCKER_REGISTRY=

# Base Domain Configuration
BASE_DOMAIN=ubuntu.slightlyprivate.com

# Service Domains
WEB_DOMAIN=petcare.web.${BASE_DOMAIN}
UI_DOMAIN=petcare.ui.${BASE_DOMAIN}
PWA_DOMAIN=petcare.pwa.${BASE_DOMAIN}

# Container Names
APP_CONTAINER_NAME=petcare_app_prod
WEB_CONTAINER_NAME=petcare_web_prod
UI_CONTAINER_NAME=petcare_ui_prod
PWA_CONTAINER_NAME=petcare_pwa_prod
WORKER_CONTAINER_NAME=petcare_worker_prod
SCHEDULER_CONTAINER_NAME=petcare_scheduler_prod

# Image Tags
IMAGE_TAG=release-latest

# Traefik Configuration
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver

# Storage Path
STORAGE_PATH=/mnt/data/appdata/petcare-storage-prod
