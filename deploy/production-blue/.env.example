APP_NAME=PetCare Companion
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${WEB_DOMAIN}

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=petcare
DB_USERNAME=petcare
DB_PASSWORD=petcare
DB_ROOT_PASSWORD=rootpass

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=production@example.com
MAIL_FROM_NAME="${APP_NAME} Production"

# === INFRASTRUCTURE CONFIG ===
ENV=prod

# Docker Registry - Must be explicitly set (no default)
# Example: ghcr.io/slightlyprivate
DOCKER_REGISTRY=

# Blue/Green Deployment Slot
SLOT=blue

# Base Domain Configuration
BASE_DOMAIN=petcare.ubuntu.slightlyprivate.com

# Service Domains (for Traefik)
WEB_DOMAIN=web.petcare.ubuntu.slightlyprivate.com
UI_DOMAIN=ui.petcare.ubuntu.slightlyprivate.com
PWA_DOMAIN=pwa.petcare.ubuntu.slightlyprivate.com

# Container Names (include slot suffix)
APP_CONTAINER_NAME=petcare_app_blue
WEB_CONTAINER_NAME=petcare_web_blue
UI_CONTAINER_NAME=petcare_ui_blue
PWA_CONTAINER_NAME=petcare_pwa_blue
WORKER_CONTAINER_NAME=petcare_worker_blue

# Image Tags
# Pattern: latest (latest main build) or specific version (e.g., 1.2.3)
# Set by CI/CD pipeline on push to main branch
IMAGE_TAG=latest

# Traefik Configuration
# TRAEFIK_ENABLE controls whether this slot is active
# Active slot: TRAEFIK_ENABLE=true
# Inactive slot: TRAEFIK_ENABLE=false
TRAEFIK_ENABLE=false
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfresolver
