# PetCare Companion .env.example - Local Development Template
# Copy to .env, generate APP_KEY with 'php artisan key:generate', and customize for your environment.
# For staging/prod, override in .env.local or use docker-compose env_file.

# === INFRASTRUCTURE CONFIG ===
# Override container hostnames in docker-compose.yml or per-env files for multi-env support.
APP_CONTAINER_NAME=petcare_app_local
WEB_CONTAINER_NAME=petcare_web_local
UI_CONTAINER_NAME=petcare_ui_local
PWA_CONTAINER_NAME=petcare_pwa_local
WORKER_CONTAINER_NAME=petcare_worker_local
SCHEDULER_CONTAINER_NAME=petcare_scheduler_local

# === APP CONFIG ===
APP_NAME="PetCare Companion (Local)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Frontend URL for caregiver invitation emails and CORS
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=petcare_mysql_local
DB_PORT=3306
DB_DATABASE=petcare_local
DB_USERNAME=petcare
DB_PASSWORD=petcare
DB_ROOT_PASSWORD=rootpass

# === CACHE / QUEUE / SESSION ===
REDIS_HOST=petcare_redis_local
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# === MAIL ===
# Uses log driver for local dev; switch to smtp/postmark/etc. in prod and uncomment below.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@petcare.local"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null

# === PAYMENTS ===
# Stripe (optional for credit purchases & webhooks)
# Use live keys in production; store secrets securely (e.g., via Docker secrets).
STRIPE_KEY=pk_test_your_key_here
STRIPE_SECRET=sk_test_your_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
